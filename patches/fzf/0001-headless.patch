--- /dev/null
+++ b/src/tui/headless.go
@@ -0,0 +1,130 @@
+package tui
+
+import "sync"
+
+const (
+	headlessWidth  = 80
+	headlessHeight = 24
+)
+
+// HeadlessRenderer is a no-op Renderer for --listen without a TTY.
+type HeadlessRenderer struct {
+	mu     sync.Mutex
+	cancel chan struct{}
+	closed bool
+}
+
+type HeadlessWindow struct {
+	top    int
+	left   int
+	width  int
+	height int
+	posx   int
+	posy   int
+}
+
+func NewHeadlessRenderer() Renderer {
+	return &HeadlessRenderer{}
+}
+
+func (r *HeadlessRenderer) DefaultTheme() *ColorTheme { return NoColorTheme }
+func (r *HeadlessRenderer) Init() error               { return nil }
+func (r *HeadlessRenderer) Resize(func(int) int)      {}
+func (r *HeadlessRenderer) Pause(bool)                {}
+func (r *HeadlessRenderer) Resume(bool, bool)         {}
+func (r *HeadlessRenderer) Clear()                    {}
+func (r *HeadlessRenderer) RefreshWindows([]Window)   {}
+func (r *HeadlessRenderer) Refresh()                  {}
+func (r *HeadlessRenderer) PassThrough(string)        {}
+func (r *HeadlessRenderer) NeedScrollbarRedraw() bool { return false }
+func (r *HeadlessRenderer) ShouldEmitResizeEvent() bool {
+	return false
+}
+func (r *HeadlessRenderer) Bell()       {}
+func (r *HeadlessRenderer) HideCursor() {}
+func (r *HeadlessRenderer) ShowCursor() {}
+func (r *HeadlessRenderer) Top() int    { return 0 }
+func (r *HeadlessRenderer) MaxX() int   { return headlessWidth }
+func (r *HeadlessRenderer) MaxY() int   { return headlessHeight }
+func (r *HeadlessRenderer) Size() TermSize {
+	return TermSize{Lines: headlessHeight, Columns: headlessWidth}
+}
+
+func (r *HeadlessRenderer) GetChar(cancellable bool) Event {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return Event{Invalid, 0, nil}
+	}
+	if !cancellable {
+		r.mu.Unlock()
+		select {}
+	}
+	ch := make(chan struct{})
+	r.cancel = ch
+	r.mu.Unlock()
+	<-ch
+	return Event{Invalid, 0, nil}
+}
+
+func (r *HeadlessRenderer) CancelGetChar() {
+	r.mu.Lock()
+	if r.cancel != nil {
+		close(r.cancel)
+		r.cancel = nil
+	}
+	r.mu.Unlock()
+}
+
+func (r *HeadlessRenderer) Close() {
+	r.mu.Lock()
+	r.closed = true
+	if r.cancel != nil {
+		close(r.cancel)
+		r.cancel = nil
+	}
+	r.mu.Unlock()
+}
+
+func (r *HeadlessRenderer) NewWindow(top int, left int, width int, height int, windowType WindowType, borderStyle BorderStyle, erase bool) Window {
+	return &HeadlessWindow{top: top, left: left, width: width, height: height}
+}
+
+func (w *HeadlessWindow) Top() int                             { return w.top }
+func (w *HeadlessWindow) Left() int                            { return w.left }
+func (w *HeadlessWindow) Width() int                           { return w.width }
+func (w *HeadlessWindow) Height() int                          { return w.height }
+func (w *HeadlessWindow) DrawBorder()                          {}
+func (w *HeadlessWindow) DrawHBorder()                         {}
+func (w *HeadlessWindow) DrawHSeparator(int, WindowType, bool) {}
+func (w *HeadlessWindow) PaintSectionFrame(int, int, WindowType, SectionEdge) {
+}
+func (w *HeadlessWindow) Refresh()    {}
+func (w *HeadlessWindow) FinishFill() {}
+func (w *HeadlessWindow) X() int      { return w.posx }
+func (w *HeadlessWindow) Y() int      { return w.posy }
+func (w *HeadlessWindow) EncloseX(x int) bool {
+	return x >= w.left && x < w.left+w.width
+}
+func (w *HeadlessWindow) EncloseY(y int) bool {
+	return y >= w.top && y < w.top+w.height
+}
+func (w *HeadlessWindow) Enclose(y int, x int) bool {
+	return w.EncloseX(x) && w.EncloseY(y)
+}
+func (w *HeadlessWindow) Move(y int, x int) {
+	w.posy = y
+	w.posx = x
+}
+func (w *HeadlessWindow) MoveAndClear(y int, x int) { w.Move(y, x) }
+func (w *HeadlessWindow) Print(string)              {}
+func (w *HeadlessWindow) CPrint(ColorPair, string)  {}
+func (w *HeadlessWindow) Fill(string) FillReturn    { return FillSuspend }
+func (w *HeadlessWindow) CFill(Color, Color, Color, Attr, string) FillReturn {
+	return FillSuspend
+}
+func (w *HeadlessWindow) LinkBegin(string, string) {}
+func (w *HeadlessWindow) LinkEnd()                 {}
+func (w *HeadlessWindow) Erase()                   {}
+func (w *HeadlessWindow) EraseMaybe() bool         { return false }
+func (w *HeadlessWindow) SetWrapSign(string, int)  {}
